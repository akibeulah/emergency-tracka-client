# Facility console build flags. Copy to .env.local (gitignored) and adjust.
# Vite inlines these at build time: restart `npm run dev` after changing them.

# 'live' talks to server/; 'mock' (the default) runs entirely in the browser on example data.
VITE_API_MODE=live

# The server's API root, including /api.
VITE_API_URL=http://localhost:3000/api

# Live mode only: modules to answer from the in-browser mock instead of the server,
# comma-separated (auth, registry, facility, beds, staff, roster, pricing, blood).
# Those pages are labelled "Example data". Leave empty to show honest "not available" states.
VITE_MOCK_MODULES=

# Blood inventory (G2). Keep false while the server's FEATURE_BLOOD is off (its routes answer 404).
VITE_FEATURE_BLOOD=false
